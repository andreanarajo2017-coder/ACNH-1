NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# D-03: PostgreSQL 16
DATABASE_URL=postgresql://copiloto:copiloto@localhost:5432/copiloto

# D-11: JWT access (15 min) + rotating refresh (30 days)
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me

# D-04: Anthropic API key for the real LlmProvider adapter. Leave unset to
# use FakeProvider in dev/test.
ANTHROPIC_API_KEY=

# D-06: Firebase service account JSON (single line) for the real
# PushProvider (FCM/APNs). Leave unset to use FakePushProvider in dev/test.
FCM_SERVICE_ACCOUNT_JSON=
